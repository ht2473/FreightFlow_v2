    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.17",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.14.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "terra-draw": "1.37.0",
