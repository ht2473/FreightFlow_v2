{
  "name": "freightflow-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.17",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.14.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
}
