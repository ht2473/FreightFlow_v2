# Режим: dev или prod
FF_ENV=dev

# HTTP
FF_HTTP_ADDR=:8080
FF_BASE_URL=http://localhost:8080
FF_METRICS_ADDR=127.0.0.1:9090
# В режиме dev статика SPA проксируется на сервер Vite
FF_DEV_VITE_URL=http://localhost:5173

# База данных
FF_DATABASE_URL=postgres://freightflow:freightflow@localhost:55442/freightflow?sslmode=disable

# Каталог данных приложения (снимки источников, подложка, граф, файлы)
FF_DATA_DIR=./var

# Ключи: 32 случайных байта в hex (openssl rand -hex 32)
FF_SESSION_KEY=
FF_ENCRYPTION_KEY=

# Почта
FF_SMTP_HOST=localhost
FF_SMTP_PORT=1035
FF_SMTP_USER=
FF_SMTP_PASSWORD=
FF_SMTP_FROM=FreightFlow <noreply@freightflow.local>

# Telegram-бот
FF_TELEGRAM_BOT_TOKEN=

# Портал открытых данных Москвы
FF_MOSDATA_API_KEY=

# Корневой сертификат Минцифры для российских государственных источников (PEM)
FF_RU_CA_FILE=./var/certs/russian_trusted_root_ca.pem

# Службы
FF_VALHALLA_URL=http://localhost:8002
FF_PDF_CDP_URL=ws://localhost:9222

# Наблюдаемость
FF_LOG_LEVEL=info
FF_LOG_FORMAT=text
FF_OTLP_ENDPOINT=
