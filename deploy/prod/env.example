# Настройки сервера: скопировать в /srv/freightflow/.env и заполнить (chmod 600).
# Значения ключей и паролей генерируются на сервере: openssl rand -hex 32

# Домен (сертификат Let's Encrypt выпускается автоматически)
FF_DOMAIN=freightflow.ru
FF_BASE_URL=https://freightflow.ru

# Пароль базы данных (только буквы и цифры — входит в адрес подключения)
FF_DB_PASSWORD=

# Ключи сессий и шифрования секретов (2FA, вебхуки): 32 случайных байта в hex.
# Ключ шифрования не менять: иначе 2FA и сохранённые секреты перестанут расшифровываться.
FF_SESSION_KEY=
FF_ENCRYPTION_KEY=

# Почта (приглашения, смена пароля, уведомления). Пусто — письма не уходят, ссылки приглашений
# администратор копирует в интерфейсе. Например, Яндекс 360: smtp.yandex.ru, 465, ящик и пароль приложения.
FF_SMTP_HOST=
FF_SMTP_PORT=465
FF_SMTP_USER=
FF_SMTP_PASSWORD=
FF_SMTP_FROM=FreightFlow <noreply@freightflow.ru>

# Портал открытых данных Москвы (обновления по расписанию)
FF_MOSDATA_API_KEY=

# Telegram-бот оповещений; пусто — канал отключён
FF_TELEGRAM_BOT_TOKEN=

# Журнал в JSON — удобно читать docker compose logs и отправлять в сборщики
FF_LOG_LEVEL=info
FF_LOG_FORMAT=json
FF_TRACE_RATIO=0
