package web

import (
	"fmt"

	"freightflow/internal/analytics"
	"freightflow/internal/ingest"
)

templ helpLayout(p page, current string) {
	<!DOCTYPE html>
	<html lang="ru" if p.Theme != "" {
		data-theme={ p.Theme }
	}>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ p.Title } — Справка FreightFlow</title>
			<link rel="stylesheet" href={ p.CSS }/>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
		</head>
		<body class="help-body">
			<a class="help-skip" href="#content">К содержанию</a>
			<header class="help-header">
				<a class="auth-brand" href="/help/guide"><span class="auth-brand-mark" aria-hidden="true">FF</span>FreightFlow · Справка</a>
				<a class="btn btn-sm" href="/dashboard">В систему</a>
			</header>
			<div class="help-wrap">
				<nav class="help-nav" aria-label="Разделы справки">
					<ul>
						for _, it := range helpPages {
							<li>
								<a href={ templ.SafeURL(it.Path) } if it.Path == current {
									aria-current="page"
								}>{ it.Title }</a>
							</li>
						}
					</ul>
				</nav>
				<main id="content" class="help-main">
					<h1>{ p.Title }</h1>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ mdText(items []mdSpan) {
	for _, s := range items {
		if s.Code {
			<code>{ s.Text }</code>
		} else {
			{ s.Text }
		}
	}
}

templ mdBlocks(blocks []mdBlock) {
	for _, b := range blocks {
		if b.List {
			<ul>
				for _, it := range b.Items {
					<li>
						@mdText(it)
					</li>
				}
			</ul>
		} else {
			for _, it := range b.Items {
				<p>
					@mdText(it)
				</p>
			}
		}
	}
}

templ helpMethodsPage(p page, current string, groups []methodGroup) {
	@helpLayout(p, current) {
		<p class="help-lead">
			Каждый показатель считается по открытым данным с указанной методикой; расчётные значения в интерфейсе помечены «модель».
			Показатель пересчитывается при изменении исходных данных.
		</p>
		<nav aria-label="Группы показателей" class="help-toc">
			<ul>
				for _, g := range groups {
					<li><a href={ templ.SafeURL("#" + groupID(g.Title)) }>{ g.Title } ({ fmt.Sprint(len(g.Metrics)) })</a></li>
				}
			</ul>
		</nav>
		for _, g := range groups {
			<section aria-labelledby={ groupID(g.Title) }>
				<h2 id={ groupID(g.Title) }>{ g.Title }</h2>
				for _, m := range g.Metrics {
					@methodCard(m)
				}
			</section>
		}
	}
}

templ methodCard(m analytics.Def) {
	<article class="help-card" id={ m.Code }>
		<h3>{ m.Title }</h3>
		<p class="help-meta">
			<code>{ m.Code }</code>
			if m.Unit != "" {
				· { m.Unit }
			}
			· уровни: { levelsText(m.Levels) }
			· версия { fmt.Sprint(m.Version) }
			if m.ComputedAt != nil {
				· рассчитан { dateText(m.ComputedAt) }
			}
		</p>
		if m.Formula != "" {
			<p class="help-formula"><span class="help-label">Формула:</span> <code>{ m.Formula }</code></p>
		}
		@mdBlocks(markdown(m.Method))
	</article>
}

templ helpSourcesPage(p page, current string, list []ingest.SourceStatus) {
	@helpLayout(p, current) {
		<p class="help-lead">
			Все данные системы — открытые. Атрибуция указывается на карте, в карточках, отчётах и каждой выгрузке;
			условия использования — по лицензии источника.
		</p>
		<div class="help-table-wrap">
			<table class="table">
				<caption class="visually-hidden">Источники данных</caption>
				<thead>
					<tr>
						<th scope="col">Источник</th>
						<th scope="col">Правообладатель</th>
						<th scope="col">Лицензия, атрибуция</th>
						<th scope="col">Обновление</th>
						<th scope="col">Последняя загрузка</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range list {
						<tr>
							<td>
								if s.URL != "" {
									<a href={ templ.SafeURL(s.URL) } rel="noreferrer">{ s.Title }</a>
								} else {
									{ s.Title }
								}
							</td>
							<td>{ s.Publisher }</td>
							<td>{ s.License }<div class="help-meta">{ s.Attribution }</div></td>
							<td>{ intervalText(s.Interval) }</td>
							<td>{ dateText(s.LastSuccessAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<h2>Код системы</h2>
		<p>Исходный код FreightFlow распространяется по лицензии MIT. Подложка карты — Protomaps (OpenStreetMap, Natural Earth), ODbL 1.0.</p>
	}
}

// term — статья словаря.
type term struct {
	Name string
	Text string
}

var glossary = []term{
	{"Объект логистики", "Склад, логистический или сортировочный центр, терминал, холодильный склад, оптовая площадка или порт из реестра. Запись собирается из OpenStreetMap и уточняется адресным реестром, разрешениями на ввод и правками редактора."},
	{"Достоверность записи", "Оценка от 0 до 1, насколько запись реестра отражает действующий объект логистики: разметка назначения, здания, адрес, разрешение на ввод. Причины показываются в карточке."},
	{"Пояс", "Положение объекта относительно колец: внутри Садового кольца, Садовое — ТТК, ТТК — МКАД, МКАД — ЦКАД, за ЦКАД."},
	{"Зоны ограничения движения", "Территории внутри МКАД, ТТК и Садового кольца, где въезд грузовиков ограничен по массе, экологическому классу и времени; въезд по пропуску. Правила — с основаниями в правовых актах (раздел «Регулирование»)."},
	{"Профиль ТС", "Габариты и масса транспортного средства (фургон 3,5 т … тягач 40 т), по которым маршрутизация учитывает ограничения проезда."},
	{"Ограничение проезда", "Запрет въезда грузовиков или предел массы, нагрузки на ось, высоты, ширины, длины на участке дороги — из OpenStreetMap и реестра дорожных знаков."},
	{"Изохрона", "Область, достижимая от точки за заданное время для выбранного профиля ТС."},
	{"Доступность объекта", "Время в пути грузовика от объекта до МКАД, ТТК, центра и ж/д грузовых пунктов по графу сети с ограничениями."},
	{"Значимость участка", "Доля кратчайших маршрутов между объектами, проходящих через участок (центральность по посредничеству)."},
	{"Критичный элемент сети", "Мост или участок, выпадение которого сильнее всего увеличивает время доступности объектов (ущерб — в объекто-минутах)."},
	{"Ячейка H3", "Шестиугольник глобальной сетки H3: разрешение 8 — около 0,7 км², 9 — около 0,1 км². Показатели по ячейкам сравнимы между частями города."},
	{"Сводный индекс", "Взвешенная сумма нормированных показателей (доступности, обеспеченности, ограничений); веса настраиваются, чувствительность рейтинга к ним показывается."},
	{"MASE", "Средняя абсолютная ошибка прогноза, отнесённая к ошибке сезонной наивной модели: меньше 1 — модель лучше «как год назад». По ней выбирается модель прогноза."},
	{"Горячая точка (Gi*)", "Территория, где значение показателя вместе с соседями значимо выше среднего (статистика Getis–Ord)."},
	{"DBSCAN", "Выделение плотных скоплений объектов: кластер — группа точек ближе заданного расстояния друг к другу."},
	{"Сценарий «что если»", "Расчёт последствий перекрытий, изменения правил зон, другого профиля ТС или нового объекта: сравнение доступности базы и сценария."},
	{"МАИ", "Метод анализа иерархий: веса критериев из попарных сравнений; согласованность сравнений — коэффициент CR (до 0,1 — приемлемо)."},
	{"TOPSIS", "Ранжирование вариантов по близости к идеальному и удалённости от худшего решения; используется в оценке локации."},
	{"Алерт", "Срабатывание правила оповещения: новая работа на коридоре, изменение ограничений, рост времени доступности, новый объект, сбой источника. Статусы: активен, подтверждён, закрыт."},
	{"Тихие часы", "Время, когда некритичные письма и сообщения Telegram откладываются до утра; критичные приходят сразу."},
	{"Дайджест", "Одно письмо в выбранный час со всеми алертами за сутки вместо писем по каждому."},
	{"Вебхук", "Запрос POST с данными алерта на адрес внешней системы; подписан секретом (HMAC-SHA256)."},
	{"Токен API", "Ключ доступа к API без браузера с выбранными правами и сроком действия; выпускается в профиле."},
	{"Версия данных", "Номер публикации домена данных: растёт после каждой успешной загрузки; по нему пересчитываются показатели и обновляются кеши."},
}

templ helpGlossaryPage(p page, current string) {
	@helpLayout(p, current) {
		<dl class="help-glossary">
			for _, t := range glossary {
				<div>
					<dt>{ t.Name }</dt>
					<dd>{ t.Text }</dd>
				</div>
			}
		</dl>
	}
}

// guideSection — раздел системы в руководстве.
type guideSection struct {
	Title string
	Path  string
	Text  string
}

var guide = []guideSection{
	{"Дашборд", "/dashboard", "Ключевые показатели, ряды с прогнозами, рейтинги и обновления данных. «Настроить» — свой набор виджетов."},
	{"Карта", "/map", "Подложка и слои: объекты, ограничения, работы на дату, зоны, стоянки, ячейки H3. Выделение области со сводкой, измерение, сохранённые виды, изображение карты с легендой."},
	{"Алерты", "/alerts", "Лента алертов по вашим правилам в реальном времени, подтверждение, назначение, комментарии. Вкладка «Правила» — конструктор: коридор или область рисуются на карте."},
	{"Объекты", "/facilities", "Реестр с фасетами и фильтрами, выгрузка CSV, XLSX, GeoJSON, GeoPackage; карточка объекта с доступностью, ограничениями и работами рядом, паспорт PDF."},
	{"Территории", "/territories", "Округа и районы с показателями и местом в рейтинге; профиль территории и сводка PDF."},
	{"Транспортная сеть", "/network", "Маршрут грузовика с учётом ограничений и зон, изохроны, матрица времени, сетевой анализ: значимость участков, узкие места, критичные элементы."},
	{"Регулирование", "/regulation", "Правила зон ограничения с основаниями, грузовой каркас, статистика пропусков и спецразрешений."},
	{"Аналитика", "/analytics", "Каталог показателей с картограммами, сводные индексы с весами, ряды и прогнозы, горячие точки и кластеры."},
	{"Сценарии", "/scenarios", "Расчёты «что если»: перекрытия, правила зон, новый объект — сравнение на двух картах; устойчивость сети."},
	{"Оценка локации", "/site-selection", "Подбор мест для нового объекта: критерии по ячейкам H3, исключающие зоны, веса (вручную или МАИ), рейтинг TOPSIS."},
	{"Отчёты", "/reports", "Отчёты PDF и XLSX по шаблонам, расписания с рассылкой на почту. Отчёт хранится неделю."},
	{"API", "/api-docs", "Документация программного доступа, токены, вебхуки."},
	{"Профиль", "/profile", "Имя, тема, пароль, двухфакторная защита, уведомления (почта, Telegram, вебхуки), токены API."},
}

templ helpGuidePage(p page, current string) {
	@helpLayout(p, current) {
		<p class="help-lead">
			FreightFlow — мониторинг и анализ логистической инфраструктуры Москвы на открытых данных.
			Поиск по всей системе — <kbd>Ctrl</kbd> + <kbd>K</kbd>: объекты, адреса, улицы, районы, правовые акты, работы;
			запрос вида «склады ЮВАО больше 10 000 м² у МКАД» разбирается в фильтры реестра.
		</p>
		<div class="help-grid">
			for _, g := range guide {
				<article class="help-card">
					<h2><a href={ templ.SafeURL(g.Path) }>{ g.Title }</a></h2>
					<p>{ g.Text }</p>
				</article>
			}
		</div>
		<h2>Права</h2>
		<p>
			Разделы видны по ролям: наблюдатель смотрит карту, реестр и отчёты; аналитик работает с выгрузками, отчётами,
			сценариями и правилами оповещений; оператор подтверждает и закрывает алерты; редактор данных ведёт источники
			и уточняет реестр; администратор управляет пользователями и настройками.
		</p>
	}
}

templ helpAboutPage(p page, current, version string) {
	@helpLayout(p, current) {
		<p class="help-lead">
			Информационная система мониторинга и анализа логистической инфраструктуры Москвы: реестр объектов, дорожная сеть
			с ограничениями для грузового транспорта, маршруты, показатели и прогнозы, сценарии, оповещения и отчёты.
		</p>
		<dl class="help-glossary">
			<div><dt>Версия</dt><dd>{ version }</dd></div>
			<div><dt>Данные</dt><dd>Открытые источники — см. <a href="/help/sources">Источники и лицензии</a>.</dd></div>
			<div><dt>Код</dt><dd>Лицензия MIT.</dd></div>
			<div><dt>Доступность</dt><dd>Интерфейс проверяется на соответствие WCAG 2.2 AA в светлой и тёмной темах.</dd></div>
		</dl>
	}
}
